# ==========================================
# Lucid Backend Environment Configuration
# ==========================================

# Server Environment
PORT=5000
FLASK_ENV=production

# Production CORS Whitelist (comma-separated origins)
CORS_ORIGINS=https://www.yourdomain.com,https://yourdomain.com,http://localhost:5173

# Optional: Custom Tesseract Binary Path (auto-detected if omitted)
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default: /usr/bin/tesseract
# TESSERACT_CMD=/usr/bin/tesseract

# ==========================================
# External Fact-Checking & Search API Keys
# ==========================================

# Google Fact Check Tools API Key
FACTCHECK_API_KEY=

# GNews API Key for live news retrieval
GNEWS_API_KEY=

# Google Gemini API Key for deep summarization & synthesis
GEMINI_API_KEY=

# OpenAI API Key (alternative / fallback LLM reasoning)
OPENAI_API_KEY=
